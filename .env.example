# LLM Vision API — PDF 文本识别
# 支持 OpenAI / DeepSeek / 智谱 GLM / 月之暗面 等兼容接口
VITE_LLM_API_KEY=sk-your-api-key-here
VITE_LLM_BASE_URL=https://api.openai.com/v1
VITE_LLM_MODEL=gpt-4o-mini

# 腾讯云机器翻译 TMT
# 1. 去 https://console.cloud.tencent.com/cam/capi 获取 SecretId 和 SecretKey
# 2. 去 https://console.cloud.tencent.com/tmt 开通机器翻译服务（每月 500 万字符免费额度）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# ── HTTPS 由 Caddy/Nginx 反向代理处理，参见 DEPLOY.md ──

# 用户数据目录（独立于部署目录，更新代码不会丢失数据）
DATA_DIR=/root/eldata

# 服务端口（默认 3000）
PORT=3000

# 管理员初始化（首次部署时设置，将该用户名自动提升为管理员）
ADMIN_USERNAME=admin

# Service Worker 需排除的同域名子路径前缀（逗号分隔）。
# 与 Caddyfile 中的静态站点 handle 块对应，这些路径的导航请求直连网络，
# 不被本应用的 PWA Service Worker 导航兜底劫持。
# 默认已内置 jd_view / lx_vibe，新增子路径时在此追加即可，例如：
# LEXILEARN_SW_EXCLUDES=docs,blog
# LEXILEARN_SW_EXCLUDES=
